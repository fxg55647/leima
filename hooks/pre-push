#!/bin/sh
# pre-push hook -- tarkistaa POIDE-statuksen ennen git push -komentoa.
#
# Asennus:
#   cp hooks/pre-push .git/hooks/pre-push
#   chmod +x .git/hooks/pre-push   # Linux/macOS
#
# Ohita hatatilanteessa: git push --no-verify

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
SCRIPT="$REPO_ROOT/hooks/pre-push.py"

if [ ! -f "$SCRIPT" ]; then
  exit 0
fi

for PY in \
  "$REPO_ROOT/.venv/Scripts/python" \
  "$REPO_ROOT/.venv/bin/python3" \
  python3 \
  python \
  py
do
  if command -v "$PY" >/dev/null 2>&1 || [ -f "$PY" ]; then
    "$PY" "$SCRIPT"
    exit $?
  fi
done

# Python ei loydy -- sallitaan push
exit 0
